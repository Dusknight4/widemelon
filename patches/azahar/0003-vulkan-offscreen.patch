+void PresentWindow::CopyToHost(Frame* frame) {
+    const vk::Device device = instance.GetDevice();
+    const u32 stride = frame->width * 4;
+    const u32 size = stride * frame->height;
+    if (frame->readback_size != size) {
+        if (frame->readback) {
+            vmaDestroyBuffer(instance.GetAllocator(), frame->readback, frame->readback_allocation);
+            frame->readback = vk::Buffer{};
+        }
+        const VkBufferCreateInfo buffer_info = {
+            .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+            .size = size,
+            .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+        };
+        const VmaAllocationCreateInfo alloc_info = {
+            .flags = VMA_ALLOCATION_CREATE_MAPPED_BIT |
+                     VMA_ALLOCATION_CREATE_HOST_ACCESS_RANDOM_BIT,
+            .usage = VMA_MEMORY_USAGE_AUTO_PREFER_HOST,
+        };
+        VkBuffer buffer{};
+        VmaAllocationInfo info{};
+        if (vmaCreateBuffer(instance.GetAllocator(), &buffer_info, &alloc_info, &buffer,
+                            &frame->readback_allocation, &info) != VK_SUCCESS) [[unlikely]] {
+            LOG_CRITICAL(Render_Vulkan, "Failed allocating the offscreen frame's memory");
+            UNREACHABLE();
+        }
+        frame->readback = vk::Buffer{buffer};
+        frame->readback_pixels = static_cast<u8*>(info.pMappedData);
+        frame->readback_size = size;
