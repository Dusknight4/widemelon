+// Copyright 2026 WideMelon contributors
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// MultiMelon: the Vulkan renderer without a window. When the EmuWindow's WindowSystemType is
+// Headless there is no surface and no swapchain: each frame is drawn as usual (in the window's
+// framebuffer layout), then copied into memory and handed to the handler set here, on the
+// thread that presents (the one running the core). MultiMelon shows the frames in its own
+// OpenGL window this way on macOS, where Azahar has no OpenGL renderer.
+
+#pragma once
+
+#include <functional>
+#include "common/common_types.h"
+
+namespace Vulkan {
+
+/// pixels: RGBA8, row 0 the top of the layout, `stride` bytes from one row to the next; only
+/// valid during the call
+using OffscreenFrameHandler =
+    std::function<void(const u8* pixels, u32 width, u32 height, u32 stride)>;
+
+/// (an empty handler drops the frames)
+void SetOffscreenFrameHandler(OffscreenFrameHandler handler);
+
+} // namespace Vulkan
