@@ -0,0 +1,33 @@
+// Copyright 2026 WideMelon contributors
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// MultiMelon: a frontend's own transport for the UDS service's 802.11 frames, in place of a room
+// (MultiMelon's "Wifi as Local Multiplayer": other MultiMelons and real 3DSes on the same network).
+
+#pragma once
+
+#include <functional>
+#include <memory>
+#include "network/room_member.h"
+
+namespace Service::NWM {
+
+struct UdsLink {
+    // a frame to send (its transmitter_address already this console's); mustn't block
+    std::function<void(const Network::WifiPacket&)> send;
+    // this console's MAC address on the link
+    Network::MacAddress mac{};
+};
+
+// From then on frames go through the link instead of a room (null: the room again). Set it before a game
+// starts: the console's MAC address is read when the UDS service starts.
+void SetUdsLink(std::shared_ptr<UdsLink> link);
+
+// A frame from the link, for this console (from any thread).
+void DeliverUdsPacket(const Network::WifiPacket& packet);
+
+// The game has the UDS service initialized (its local wireless is on).
+bool UdsActive();
+
+} // namespace Service::NWM
