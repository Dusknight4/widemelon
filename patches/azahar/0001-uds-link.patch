+// MultiMelon: a frontend's transport instead of a room (uds_link.h). Two locks: sending can happen while
+// the service holds its own lock, and a frame delivered from the link takes that lock.
+namespace {
+std::mutex g_link_send_mutex;
+std::shared_ptr<UdsLink> g_link;
+std::mutex g_link_deliver_mutex;
+std::function<void(const Network::WifiPacket&)> g_link_deliver; // the running service's OnWifiPacketReceived
+std::function<bool()> g_link_active;
+std::function<void(const Network::MacAddress&)> g_link_drop; // the running service's: a console has gone
+
+std::shared_ptr<UdsLink> CurrentLink() {
+    std::scoped_lock lock{g_link_send_mutex};
+    return g_link;
+}
+} // namespace
+
+void SetUdsLink(std::shared_ptr<UdsLink> link) {
+    std::scoped_lock lock{g_link_send_mutex};
+    g_link = std::move(link);
+}
+
+void DeliverUdsPacket(const Network::WifiPacket& packet) {
+    std::scoped_lock lock{g_link_deliver_mutex};
+    if (g_link_deliver) {
+        g_link_deliver(packet);
+    }
+}
+
+bool UdsActive() {
+    std::scoped_lock lock{g_link_deliver_mutex};
+    return g_link_active && g_link_active();
+}
+
+void DropUdsPeer(const Network::MacAddress& mac) {
+    std::scoped_lock lock{g_link_deliver_mutex};
+    if (g_link_drop) {
+        g_link_drop(mac);
+    }
+}
+
