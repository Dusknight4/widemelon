#define VOS_NT_WINDOWS32    0x00040004L
#define VFT_APP                      0x00000001L

// WideMelon shell, taskbar, and SmartScreen icon.
100 ICON MOVEABLE PURE LOADONCALL DISCARDABLE "${CMAKE_SOURCE_DIR}/res/widemelon.ico"

//include version information in .exe, modify these values to match your needs
1 VERSIONINFO
FILEVERSION ${MELON_RC_VERSION}
PRODUCTVERSION ${MELON_RC_VERSION}
FILETYPE VFT_APP
{
  BLOCK "StringFileInfo"
	{
		BLOCK "040904E4"
		{
			VALUE "CompanyName", "MultiMelon contributors"
			VALUE "FileVersion", "${WIDEMELON_VERSION}"
			VALUE "FileDescription", "MultiMelon Nintendo DS emulator with cross-platform multiplayer"
			VALUE "InternalName", "multimelon"
			VALUE "LegalCopyright", "2016-2026 melonDS team; 2026 WideMelon contributors"
			VALUE "LegalTrademarks", ""
			VALUE "OriginalFilename", "multimelon.exe"
			VALUE "ProductName", "MultiMelon"
			VALUE "ProductVersion", "${WIDEMELON_VERSION}"
		}
	}
  BLOCK "VarFileInfo"
	{
		VALUE "Translation", 0x0409, 1252 //language codes
	}
}

#if (0${MINGW})
1 24 "xp.manifest"
#endif
